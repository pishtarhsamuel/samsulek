# Keep LF line endings on every OS. Windows Git would otherwise convert to CRLF,
# which breaks bash scripts (the Claude Code guard hook) with "\r" errors.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# Recorded API responses are kept byte-for-byte (some servers send CRLF line endings).
tests/fixtures/** -text
